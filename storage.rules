rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{slug}/products/{productId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/restaurantOwners/$(slug)).data.ownerUid == request.auth.uid
        && (request.resource == null || (request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png|webp)')));
    }
  }
}

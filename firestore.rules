rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth != null;} function owns(slug){return signedIn() && get(/databases/$(database)/documents/restaurants/$(slug)).data.ownerUid == request.auth.uid;} match /restaurants/{slug} { allow read: if true; allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.slug == slug && request.resource.data.active == true; allow update,delete: if owns(slug); match /tables/{id} { allow read: if true; allow write: if owns(slug); } match /menu/{id} { allow read: if true; allow write: if owns(slug); } } match /orders/{id} { allow create: if signedIn() && request.resource.data.keys().hasAll(['restaurantSlug','tableNumber','items','total','status','paymentStatus','createdAt']) && request.resource.data.status == 'new' && request.resource.data.paymentStatus == 'unpaid' && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.tableNumber is int && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug)) && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug)/tables/$(string(request.resource.data.tableNumber))); allow read: if signedIn() && owns(resource.data.restaurantSlug); allow update: if signedIn() && owns(resource.data.restaurantSlug) && request.resource.data.restaurantSlug == resource.data.restaurantSlug && request.resource.data.tableNumber == resource.data.tableNumber && request.resource.data.items == resource.data.items && request.resource.data.total == resource.data.total; allow delete: if false; } } }
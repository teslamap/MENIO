rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == 'superadmin';
    }
    function owns(slug) {
      return isPlatformAdmin() || (signedIn()
        && getAfter(/databases/$(database)/documents/restaurantOwners/$(slug)).data.ownerUid == request.auth.uid);
    }
    function ownsExisting(slug) {
      return isPlatformAdmin() || (signedIn()
        && get(/databases/$(database)/documents/restaurantOwners/$(slug)).data.ownerUid == request.auth.uid);
    }
    function isActiveCourier() {
      return signedIn()
        && exists(/databases/$(database)/documents/courierProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/courierProfiles/$(request.auth.uid)).data.role == 'courier'
        && get(/databases/$(database)/documents/courierProfiles/$(request.auth.uid)).data.active == true;
    }

    match /courierShifts/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow create, update: if isActiveCourier() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'updatedAt', 'location'])
        && request.resource.data.keys().hasAll(['online', 'updatedAt', 'location'])
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.location == null || (request.resource.data.location is map
          && request.resource.data.location.keys().hasAll(['latitude', 'longitude'])
          && request.resource.data.location.keys().hasOnly(['latitude', 'longitude'])
          && request.resource.data.location.latitude is number
          && request.resource.data.location.longitude is number
          && request.resource.data.location.latitude >= -90 && request.resource.data.location.latitude <= 90
          && request.resource.data.location.longitude >= -180 && request.resource.data.location.longitude <= 180))
        && (request.resource.data.online == false || request.resource.data.location != null);
      allow delete: if false;
    }

    match /platformSettings/{settingId} {
      allow read: if settingId == 'deliveryPricing';
      allow create, update: if settingId == 'deliveryPricing' && isPlatformAdmin()
        && request.resource.data.keys().hasAll(['restaurantToCustomerPerKm', 'courierToRestaurantPerKm', 'minimumCourierPay', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['restaurantToCustomerPerKm', 'courierToRestaurantPerKm', 'minimumCourierPay', 'updatedAt', 'updatedBy'])
        && request.resource.data.restaurantToCustomerPerKm is number
        && request.resource.data.restaurantToCustomerPerKm >= 0 && request.resource.data.restaurantToCustomerPerKm <= 1000
        && request.resource.data.courierToRestaurantPerKm is number
        && request.resource.data.courierToRestaurantPerKm >= 0 && request.resource.data.courierToRestaurantPerKm <= 1000
        && request.resource.data.minimumCourierPay is number
        && request.resource.data.minimumCourierPay >= 0 && request.resource.data.minimumCourierPay <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    function validRestaurantLocation(data) {
      return (!('restaurantLocation' in data) || (data.restaurantLocation is map
        && data.restaurantLocation.keys().hasAll(['latitude', 'longitude'])
        && data.restaurantLocation.keys().hasOnly(['latitude', 'longitude'])
        && data.restaurantLocation.latitude is number
        && data.restaurantLocation.latitude >= -90 && data.restaurantLocation.latitude <= 90
        && data.restaurantLocation.longitude is number
        && data.restaurantLocation.longitude >= -180 && data.restaurantLocation.longitude <= 180))
        && (!('restaurantAddress' in data) || (data.restaurantAddress is string && data.restaurantAddress.size() <= 300));
    }
    match /restaurants/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'slug', 'tableCount', 'nextTableNumber', 'active', 'createdAt'])
        && request.resource.data.slug == slug
        && request.resource.data.active == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.tableCount is int
        && request.resource.data.tableCount >= 1
        && request.resource.data.tableCount <= 200
        && request.resource.data.nextTableNumber == request.resource.data.tableCount + 1
        && existsAfter(/databases/$(database)/documents/restaurantOwners/$(slug))
        && getAfter(/databases/$(database)/documents/restaurantOwners/$(slug)).data.ownerUid == request.auth.uid;
      allow update: if ownsExisting(slug)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tableCount', 'nextTableNumber', 'active', 'themeColor', 'restaurantLogo', 'restaurantLocation', 'restaurantAddress'])
        && validRestaurantLocation(request.resource.data)
        && (!('themeColor' in request.resource.data) || (request.resource.data.themeColor is string
          && request.resource.data.themeColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('restaurantLogo' in request.resource.data) || (request.resource.data.restaurantLogo is string
          && request.resource.data.restaurantLogo.size() <= 180000
          && (request.resource.data.restaurantLogo == '' || request.resource.data.restaurantLogo.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}'))))
        && request.resource.data.tableCount is int
        && request.resource.data.tableCount >= 0
        && request.resource.data.tableCount <= 200
        && (!('nextTableNumber' in resource.data) || request.resource.data.nextTableNumber >= resource.data.nextTableNumber);
      allow delete: if false;

      match /tables/{tableId} {
        allow read: if true;
        allow create, update: if owns(slug)
          && request.resource.data.keys().hasOnly(['number', 'active', 'label'])
          && request.resource.data.number is int
          && request.resource.data.number >= 1
          && tableId == string(request.resource.data.number)
          && request.resource.data.active is bool
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 80
          && (resource == null || (request.resource.data.number == resource.data.number
            && (resource.data.active == true || request.resource.data.active == false)));
        allow delete: if false;
      }
      match /categories/{categoryId} {
        allow read: if true;
        allow create, update: if owns(slug)
          && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt is timestamp;
        allow delete: if owns(slug);
      }
      match /menu/{dishId} {
        allow read: if true;
        allow create, update: if owns(slug)
          && request.resource.data.keys().hasOnly(['name', 'description', 'price', 'categoryId', 'category', 'active', 'imageUrl', 'imagePath', 'createdAt', 'updatedAt', 'demo'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.price <= 100000
          && request.resource.data.active is bool
          && (!('categoryId' in request.resource.data) || request.resource.data.categoryId == ''
            || exists(/databases/$(database)/documents/restaurants/$(slug)/categories/$(request.resource.data.categoryId)))
          && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string
            && ((request.resource.data.imageUrl.size() <= 2048 && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('https://.*')))
              || (request.resource.data.imageUrl.size() <= 180000
                && request.resource.data.imageUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')))))
          && (!('imagePath' in request.resource.data) || request.resource.data.imagePath is string);
        allow delete: if owns(slug);
      }
    }

    match /restaurantOwners/{slug} {
      // A missing owner record may be checked by an authenticated registrant.
      // Existing owner records remain private; login queries must constrain ownerUid.
      allow get: if isPlatformAdmin() || (signedIn()
        && (!exists(/databases/$(database)/documents/restaurantOwners/$(slug))
          || resource.data.ownerUid == request.auth.uid));
      allow list: if isPlatformAdmin() || (signedIn()
        && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/restaurants/$(slug))
        && getAfter(/databases/$(database)/documents/restaurants/$(slug)).data.slug == slug;
      allow update, delete: if false;
    }

    // Private applications are keyed by Firebase Auth UID; review metadata is admin-only.
    function validCourierApplication(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'city', 'vehicle', 'plate', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'city', 'vehicle', 'plate', 'status', 'createdAt', 'reviewedAt', 'reviewedBy', 'rejectionReason'])
        && data.uid == uid
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 121
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.phone is string && data.phone.matches('^[+]9955[0-9]{8}$')
        && data.city is string && data.city.size() > 0 && data.city.size() <= 80
        && data.vehicle in ['bicycle', 'ebike', 'scooter', 'car', 'walking']
        && data.plate is string && data.plate.size() <= 20
        && (!(data.vehicle in ['car', 'scooter']) || data.plate.size() > 0)
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp;
    }
    function approvedCourierMatches(uid, data) {
      let application = getAfter(/databases/$(database)/documents/courierApplications/$(uid)).data;
      return data.keys().hasAll(['name', 'phone', 'email', 'city', 'vehicle', 'plate', 'role', 'active', 'createdAt', 'approvedBy'])
        && data.keys().hasOnly(['name', 'phone', 'email', 'city', 'vehicle', 'plate', 'role', 'active', 'createdAt', 'approvedBy'])
        && application.status == 'approved'
        && application.reviewedAt == request.time
        && application.reviewedBy == request.auth.uid
        && data.name == application.name && data.phone == application.phone
        && data.email == application.email && data.city == application.city
        && data.vehicle == application.vehicle && data.plate == application.plate
        && data.role == 'courier' && data.active == true
        && data.createdAt == request.time && data.approvedBy == request.auth.uid;
    }
    match /courierApplications/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validCourierApplication(request.resource.data, uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'city', 'vehicle', 'plate', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isPlatformAdmin()
        && validCourierApplication(request.resource.data, uid)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason'])
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() <= 500
        && ((request.resource.data.status == 'rejected' && request.resource.data.rejectionReason.size() > 0)
          || (request.resource.data.status == 'approved'
            && request.resource.data.rejectionReason == ''
            && approvedCourierMatches(uid, getAfter(/databases/$(database)/documents/courierProfiles/$(uid)).data)));
      allow delete: if false;
    }
    match /courierProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow create: if isPlatformAdmin()
        && get(/databases/$(database)/documents/courierApplications/$(uid)).data.status == 'pending'
        && approvedCourierMatches(uid, request.resource.data);
      allow list, update, delete: if false;
    }

    function validDeliveryLocation(data) {
      return !('deliveryLocation' in data) || (data.orderType == 'delivery'
        && data.deliveryLocation is map
        && data.deliveryLocation.keys().hasAll(['latitude', 'longitude', 'accuracy'])
        && data.deliveryLocation.keys().hasOnly(['latitude', 'longitude', 'accuracy'])
        && data.deliveryLocation.latitude is number
        && data.deliveryLocation.latitude >= -90 && data.deliveryLocation.latitude <= 90
        && data.deliveryLocation.longitude is number
        && data.deliveryLocation.longitude >= -180 && data.deliveryLocation.longitude <= 180
        && data.deliveryLocation.accuracy is number
        && data.deliveryLocation.accuracy >= 0 && data.deliveryLocation.accuracy <= 100000);
    }
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['restaurantSlug', 'tableNumber', 'tableId', 'items', 'total', 'status', 'paymentStatus', 'createdAt'])
        && request.resource.data.customerUid == request.auth.uid
        && validDeliveryLocation(request.resource.data)
        && request.resource.data.restaurantSlug is string
        && request.resource.data.tableNumber is int
        && request.resource.data.tableId is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'new'
        && request.resource.data.paymentStatus == 'unpaid'
        && !('deliveryStatus' in request.resource.data)
        && !('courierUid' in request.resource.data)
        && !('courierAssignedAt' in request.resource.data)
        && !('courierPickedUpAt' in request.resource.data)
        && !('deliveredAt' in request.resource.data)
        && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug))
        && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug)).data.active == true
        && (
          ((('orderType' in request.resource.data) && request.resource.data.orderType in ['takeaway', 'delivery'])
            && request.resource.data.tableNumber == 0
            && request.resource.data.tableId == ''
            && (request.resource.data.orderType != 'delivery'
              || (request.resource.data.deliveryAddress is string
                && request.resource.data.deliveryAddress.size() > 0
                && request.resource.data.deliveryAddress.size() <= 500
                && request.resource.data.customerPhone is string
                && request.resource.data.customerPhone.size() >= 3
                && request.resource.data.customerPhone.size() <= 40)))
          ||
          ((!('orderType' in request.resource.data) || request.resource.data.orderType == 'table')
            && request.resource.data.tableNumber >= 1
            && request.resource.data.tableId == string(request.resource.data.tableNumber)
            && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug)/tables/$(request.resource.data.tableId))
            && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug)/tables/$(request.resource.data.tableId)).data.number == request.resource.data.tableNumber
            && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantSlug)/tables/$(request.resource.data.tableId)).data.active == true)
        );
      allow read: if signedIn()
        && (isPlatformAdmin()
          || ownsExisting(resource.data.restaurantSlug)
          || resource.data.customerUid == request.auth.uid
          || (isActiveCourier()
            && resource.data.orderType == 'delivery'
            && resource.data.deliveryStatus in ['waiting', 'assigned', 'picked_up']));
      // Restaurant staff can manage the kitchen/payment fields and dispatch ready delivery orders.
      allow update: if signedIn()
        && (isPlatformAdmin() || ownsExisting(resource.data.restaurantSlug))
        && request.resource.data.restaurantSlug == resource.data.restaurantSlug
        && request.resource.data.tableNumber == resource.data.tableNumber
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentStatus', 'archived', 'deliveryStatus'])
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && request.resource.data.status in ['new', 'accepted', 'preparing', 'completed', 'cancelled']
        && request.resource.data.paymentStatus in ['unpaid', 'paid']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryStatus'])
          || (resource.data.orderType == 'delivery'
            && resource.data.status == 'completed'
            && request.resource.data.status == resource.data.status
            && request.resource.data.deliveryStatus == 'waiting'
            && (!('deliveryStatus' in resource.data)
              || !(resource.data.deliveryStatus in ['waiting', 'assigned', 'picked_up', 'delivered']))));

      // A shared courier can atomically claim an unclaimed delivery order, then advance only their own delivery.
      allow update: if isActiveCourier()
        && resource.data.orderType == 'delivery'
        && resource.data.status == 'completed'
        && request.resource.data.restaurantSlug == resource.data.restaurantSlug
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && (
          (resource.data.deliveryStatus == 'waiting'
            && (!('courierUid' in resource.data) || resource.data.courierUid == null)
            && request.resource.data.courierUid == request.auth.uid
            && request.resource.data.deliveryStatus == 'assigned'
            && get(/databases/$(database)/documents/courierShifts/$(request.auth.uid)).data.online == true
            && request.resource.data.courierPay is number && request.resource.data.courierPay >= 0
            && request.resource.data.minimumCourierPay is number && request.resource.data.minimumCourierPay >= 0
            && request.resource.data.calculatedPay is number && request.resource.data.calculatedPay >= 0
            && request.resource.data.courierPay >= request.resource.data.minimumCourierPay
            && request.resource.data.courierToRestaurantMeters is int && request.resource.data.courierToRestaurantMeters >= 0
            && request.resource.data.restaurantToCustomerMeters is int && request.resource.data.restaurantToCustomerMeters >= 0
            && request.resource.data.courierToRestaurantPerKm is number && request.resource.data.courierToRestaurantPerKm >= 0
            && request.resource.data.restaurantToCustomerPerKm is number && request.resource.data.restaurantToCustomerPerKm >= 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courierUid', 'deliveryStatus', 'courierAssignedAt', 'courierPay', 'courierToRestaurantMeters', 'restaurantToCustomerMeters', 'courierToRestaurantPerKm', 'restaurantToCustomerPerKm', 'minimumCourierPay', 'calculatedPay'])
            && request.resource.data.courierAssignedAt == request.time)
          ||
          (resource.data.courierUid == request.auth.uid
            && resource.data.deliveryStatus == 'assigned'
            && request.resource.data.deliveryStatus == 'picked_up'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus', 'courierPickedUpAt'])
            && request.resource.data.courierPickedUpAt == request.time)
          ||
          (resource.data.courierUid == request.auth.uid
            && resource.data.deliveryStatus == 'picked_up'
            && request.resource.data.deliveryStatus == 'delivered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus', 'deliveredAt'])
            && request.resource.data.deliveredAt == request.time)
        );
      allow delete: if signedIn() && (isPlatformAdmin() || ownsExisting(resource.data.restaurantSlug));
    }
  }
}
